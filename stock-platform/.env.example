# Copy this file to .env (which is gitignored) and fill in your key.
#   cp .env.example .env

# Your Marketstack / apilayer key.
MARKETSTACK_API_KEY=

# auto | native | apilayer
#   native   -> https://api.marketstack.com/v1/eod?access_key=KEY
#   apilayer -> https://api.apilayer.com/marketstack/eod  with an apikey: header
# auto tries native first, then apilayer, and remembers which one answered.
MARKETSTACK_TRANSPORT=auto

# Marketstack API version for the native transport: v1 or v2.
MARKETSTACK_API_VERSION=v1

# How long a cached response stays fresh, in seconds. Free plans have a monthly
# request cap, so caching is what keeps a day of backtesting from burning it.
MARKETLAB_CACHE_TTL=43200

# Where the web UI listens. Keep it on localhost: this process holds your key.
MARKETLAB_HOST=127.0.0.1
MARKETLAB_PORT=8787
